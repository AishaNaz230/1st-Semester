#include<stdio.h>

int main(){
    int base;
    int height;
    float area;

    printf("Enter base\n");
    scanf("%d",&base);
    printf("Base is %d\n",base);

    printf("Enter height\n");
    scanf("%d",&height);
    printf("height is %d\n",height);

    area=0.5*base*height;
    printf("The area of triangle is %f\n",area);
    return 0;
}